# Copie este archivo a .env y complete PG_ADMIN_PASSWORD. Luego: npm run local:preparar
# (genera el resto de los secretos y crea la base de control).

# Servidor PostgreSQL local (el servicio postgresql-x64-14)
PG_HOST=127.0.0.1
PG_PORT=5432
# Superusuario solo para aprovisionar (crear bases y roles). La aplicación nunca lo usa.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=

# --- los completa `npm run local:preparar` ---
# Conexión de la aplicación a la base de control (rol wms_plataforma)
CONTROL_DATABASE_URL=
# Clave que cifra las credenciales de cada cliente guardadas en wms_control (32 bytes en base64)
CONTROL_CLAVE_MAESTRA=
# Clave que firma la cookie de sesión
SESSION_SECRET=
# Cliente por defecto cuando el host no trae subdominio (solo desarrollo)
CLIENTE_POR_DEFECTO=
