/// Reglas de resurtido (propias del WMS web): cuánto debe haber de un artículo en una ubicación de picking.
/// Cuando lo libre baja al mínimo se generan tareas para traer cajas del almacenamiento hasta el máximo.
model ResurtidoRegla {
  id         Int      @id @default(autoincrement())
  bodega     String   @db.VarChar(15)
  ean        String   @db.VarChar(50)
  ubicacion  String   @db.VarChar(20)
  minimo     Decimal  @db.Decimal(18, 4)
  maximo     Decimal  @db.Decimal(18, 4)
  creada_en  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([ean, ubicacion])
  @@index([bodega])
  @@map("resurtido_regla")
}

/// Tareas de resurtido: llevar una caja de almacenamiento a la ubicación de picking.
model ResurtidoTarea {
  id               Int       @id @default(autoincrement())
  regla_id         Int?
  bodega           String    @db.VarChar(15)
  ean              String    @db.VarChar(50)
  caja             Float
  cantidad         Decimal   @db.Decimal(18, 4)
  ubicacion_origen String?   @db.VarChar(20)
  ubicacion_destino String   @db.VarChar(20)
  estado           String    @default("pendiente") @db.VarChar(12)
  creada_en        DateTime  @default(now()) @db.Timestamptz(6)
  creada_por       String?   @db.VarChar(40)
  hecha_en         DateTime? @db.Timestamptz(6)
  hecha_por        String?   @db.VarChar(40)
  nota             String?   @db.VarChar(200)

  @@index([estado])
  @@index([caja])
  @@map("resurtido_tarea")
}
