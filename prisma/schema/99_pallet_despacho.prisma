/// Pallets de despacho (propios del WMS web): agrupan cajas de despacho (las armadas en la aduana) para cargarlas juntas.
/// Estados: abierto (admite cajas), cerrado (con sus medidas y peso, listo para cargar) y despachado (con transportador, remesa y placa).
model PalletDespacho {
  id               Int       @id @default(autoincrement())
  bodega           String    @db.VarChar(15)
  estado           String    @default("abierto") @db.VarChar(12)
  creado_en        DateTime  @default(now()) @db.Timestamptz(6)
  creado_por       String?   @db.VarChar(40)
  alto             Decimal?  @db.Decimal(18, 2)
  ancho            Decimal?  @db.Decimal(18, 2)
  largo            Decimal?  @db.Decimal(18, 2)
  peso             Decimal?  @db.Decimal(18, 2)
  transportador    String?   @db.VarChar(50)
  remesa           String?   @db.VarChar(50)
  placa            String?   @db.VarChar(20)
  despachado_en    DateTime? @db.Timestamptz(6)
  despachado_por   String?   @db.VarChar(40)
  cajas            PalletDespachoCaja[]

  @@index([estado])
  @@map("pallet_despacho")
}

model PalletDespachoCaja {
  id        Int            @id @default(autoincrement())
  pallet_id Int
  picking   Int
  caja      Int
  pallet    PalletDespacho @relation(fields: [pallet_id], references: [id], onDelete: Cascade)

  @@unique([picking, caja])
  @@index([pallet_id])
  @@map("pallet_despacho_caja")
}
